# Copiez ce fichier en `.env` puis remplissez-le.
# ⚠️ `.env` est dans .gitignore : ne commitez JAMAIS de vraie clé.

# --- Service ---
GENERAPAY_ENVIRONMENT=development
GENERAPAY_VERSION=0.1.0

# --- Base de données ---
# Local / tests : sqlite:///./generapay.db
# Production    : postgresql+psycopg://USER:PASS@HOST:5432/postgres
GENERAPAY_DATABASE_URL=sqlite:///./generapay.db

# --- Supabase (étape 3 : authentification) ---
GENERAPAY_SUPABASE_URL=
GENERAPAY_SUPABASE_SERVICE_ROLE_KEY=
GENERAPAY_JWT_SECRET=

# --- Paiements ---
GENERAPAY_DEFAULT_PROVIDER=mock
GENERAPAY_PAYMENT_TTL_SECONDS=900
GENERAPAY_PLATFORM_FEE_BPS=0
GENERAPAY_MOCK_WEBHOOK_SECRET=change-me

# --- FlexPaie : à remplir quand le compte marchand sandbox est livré ---
# ⚠️ Ne rien mettre tant que le schéma de signature n'est pas documenté :
#    l'adaptateur refuse les webhooks non vérifiables (fail-closed).
GENERAPAY_FLEXPAIE_BASE_URL=
GENERAPAY_FLEXPAIE_API_KEY=
GENERAPAY_FLEXPAIE_WEBHOOK_SECRET=
GENERAPAY_FLEXPAIE_SIGNATURE_HEADER=x-flexpaie-signature
GENERAPAY_FLEXPAIE_SIGNATURE_SCHEME=unverified
GENERAPAY_FLEXPAIE_FEE_BPS=250

# --- Bac à sable ---
# À mettre à `false` en production.
GENERAPAY_ALLOW_TESTING_ENDPOINTS=true
